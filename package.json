{
  "name": "annotation-canvas",
  "version": "0.45.1",
  "description": "A powerful React canvas component for image annotation with raster and vector drawing tools. Features efficient tiling for large images, built with Konva.",
  "author": "Martin Schneider <martin.schneider@codetopic.eu>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xReav3r/annotation-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/xReav3r/annotation-canvas/issues"
  },
  "homepage": "https://github.com/xReav3r/annotation-canvas#readme",
  "keywords": [
    "react",
    "canvas",
    "annotation",
    "drawing",
    "konva",
    "image-editing",
    "raster",
    "vector",
    "graphics"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "vite",
    "build": "tsdown",
    "dev": "vite",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "konva": "^8.4.2 || ^9.0.0 || ^10.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-konva": "^18.2.5 || ^19.0.0"
  },
  "dependencies": {
    "@techstark/opencv-js": "^4.12.0-release.1",
    "localforage": "^1.10.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.8",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "react-ace": "^14.0.1",
    "react-color": "^2.19.3",
    "tsdown": "^0.16.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
